# Copy to .env.local only if needed. The site needs NO secrets to run.

# Laravel Backend API base URL (e.g. https://jebnah.com or http://127.0.0.1:8000)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Shared secret for On-Demand ISR cache revalidation from Laravel Admin (/api/revalidate)
REVALIDATE_SECRET=change-me-in-production

# Set to 1 when building a shared review copy: adds the «نسخة مراجعة» banner,
# noindex headers/meta and a robots.txt that blocks crawlers. Leave empty otherwise.
SITE_REVIEW=
